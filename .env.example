# Copy to .env and adjust. docker compose reads this file both for variable
# substitution in docker-compose.yml and (via env_file) as container env.

# ── Host-side (docker-compose.yml only) ─────────────────────────────────────
# Published port on the host
RIPPER_PORT=8083
# Optical drive block device and its SCSI generic node (`lsscsi -g`)
DISC_DEVICE_PATH=/dev/sr0
DISC_SG_DEVICE_PATH=/dev/sg0
# Host directory for intermediate rips (fast local disk recommended)
RIPS_DIR=./data/rips
# Host directory finished files are delivered to (e.g. Jellyfin ingest folder)
INGEST_DIR=./data/ingest
# Host directory holding MakeMKV's settings.conf (licence / beta key)
# MAKEMKV_CONFIG_DIR=/home/you/.MakeMKV

# ── Service settings (read by backend/config/settings.py) ───────────────────
# Path *inside the container* where INGEST_DIR is mounted. If my-media-manager
# watches the same folder, use the path it sees so reported file paths match.
INGEST_ROOT=/data/ingest

# TMDB API key (v3) — required for /tmdb/* search; unset → 503 on those routes
TMDB_API_KEY=

# OpenAI-compatible chat endpoint for optional failure analysis (LocalAI,
# Ollama's /v1, vLLM, ...). Must be reachable from inside the container —
# use the host's LAN IP or host.docker.internal rather than localhost.
LOCALAI_URL=http://localhost:8080
LOCALAI_API_KEY=
LOCALAI_ANALYSIS_MODEL=qwen2.5-14b

# my-media-manager backend (disc catalog search/create/link)
MEDIA_MANAGER_API_URL=http://localhost:8082

# ── Logging ─────────────────────────────────────────────────────────────────
HOST_ID=disc-ripper
LOG_LEVEL=INFO
# LOG_FORMAT=console   # default json

# Rip-time capture
# SCAN_TIMEOUT_SECONDS=300
# HASH_RIPPED_FILES=true
